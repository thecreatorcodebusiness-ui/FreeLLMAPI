diff --git a/src/lib/strictOffline.ts b/src/lib/strictOffline.ts
new file mode 100644
index 00000000..0516182e
--- /dev/null
+++ b/src/lib/strictOffline.ts
@@ -0,0 +1,67 @@
+/** Strict, single-dispatch fixture gateway. Normal routing never imports this path. */
+const enabled = () => process.env.OMNIROUTE_STRICT_OFFLINE === "true";
+
+export function strictOfflineEnabled(): boolean { return enabled(); }
+
+export async function strictOfflineChat(request: Request): Promise<Response> {
+  const started = Date.now();
+  const target = process.env.OMNIROUTE_OFFLINE_UPSTREAM_URL;
+  const model = process.env.OMNIROUTE_OFFLINE_MODEL;
+  const connection = process.env.OMNIROUTE_OFFLINE_CONNECTION_ID;
+  const ownHop = process.env.OMNIROUTE_OFFLINE_HOP_ID;
+  const deadline = Number(process.env.OMNIROUTE_REQUEST_DEADLINE_MS ?? "8000");
+  const fail = (status: number, code: string) => Response.json({ error: { code, message: code } }, { status });
+  let url: URL;
+  try { url = new URL(target ?? ""); } catch { return fail(503, "offline_configuration_invalid"); }
+  if (url.protocol !== "http:" || url.hostname !== "127.0.0.1" || !url.port ||
+      url.pathname !== "/v1/chat/completions" || url.search || url.hash ||
+      !model || !connection || !ownHop || !/^[a-zA-Z0-9_-]{1,64}$/.test(ownHop) ||
+      !Number.isInteger(deadline) || deadline < 1 || deadline > 60000) {
+    return fail(503, "offline_configuration_invalid");
+  }
+  const incomingHop = request.headers.get("x-omniroute-hop");
+  if (incomingHop && (!/^[a-zA-Z0-9_-]{1,64}$/.test(incomingHop) || incomingHop === ownHop))
+    return fail(508, "routing_loop");
+  if (request.headers.get("x-omniroute-connection") !== connection)
+    return fail(403, "connection_not_allowed");
+  let body: Record<string, unknown>;
+  try {
+    const parsed: unknown = await request.json();
+    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) throw Error();
+    body = parsed as Record<string, unknown>;
+  } catch { return fail(400, "invalid_json"); }
+  if (body.model !== model || !Array.isArray(body.messages)) return fail(400, "model_not_allowed");
+  const remaining = deadline - (Date.now() - started);
+  if (remaining <= 0) return fail(504, "gateway_timeout");
+  const controller = new AbortController();
+  const onAbort = () => controller.abort(request.signal.reason);
+  request.signal.addEventListener("abort", onAbort, { once: true });
+  const timer = setTimeout(() => controller.abort(new Error("deadline")), remaining);
+  const cleanup = () => { clearTimeout(timer); request.signal.removeEventListener("abort", onAbort); };
+  try {
+    const response = await fetch(url, {
+      method: "POST", headers: { "content-type": "application/json", "x-omniroute-hop": ownHop },
+      body: JSON.stringify(body), signal: controller.signal, redirect: "error", cache: "no-store",
+    });
+    const headers = new Headers();
+    headers.set("content-type", response.headers.get("content-type") || "application/json");
+    headers.set("cache-control", "no-store");
+    if (!response.body) { cleanup(); return new Response(null, { status: response.status, headers }); }
+    const reader = response.body.getReader();
+    const stream = new ReadableStream<Uint8Array>({
+      async pull(out) {
+        try {
+          const chunk = await reader.read();
+          if (chunk.done) { cleanup(); out.close(); }
+          else out.enqueue(chunk.value);
+        } catch (error) { cleanup(); out.error(error); }
+      },
+      cancel(reason) { controller.abort(reason); cleanup(); void reader.cancel(reason); },
+    });
+    return new Response(stream, { status: response.status, headers });
+  } catch {
+    cleanup();
+    return fail(controller.signal.aborted && !request.signal.aborted ? 504 : 503,
+      controller.signal.aborted && !request.signal.aborted ? "gateway_timeout" : "upstream_unavailable");
+  }
+}
