diff --git a/scripts/phase3/offline-chat.test.mjs b/scripts/phase3/offline-chat.test.mjs
new file mode 100644
index 00000000..5f6328e5
--- /dev/null
+++ b/scripts/phase3/offline-chat.test.mjs
@@ -0,0 +1,75 @@
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import { test } from 'node:test';
+import { strictOfflineChat } from '../../src/lib/strictOffline.ts';
+
+const seen = [];
+const server = http.createServer(async (req, res) => {
+  const chunks = [];
+  for await (const chunk of req) chunks.push(chunk);
+  const body = JSON.parse(Buffer.concat(chunks).toString());
+  seen.push({ body, hop: req.headers['x-omniroute-hop'] });
+  const mode = body.messages[0].content;
+  if (mode === 'slow') return setTimeout(() => res.end('{}'), 1000);
+  if (mode === 'error') { res.writeHead(503, {'content-type':'application/json'}); return res.end('{"error":"mock"}'); }
+  if (mode === 'stream') {
+    res.writeHead(200, {'content-type':'text/event-stream'});
+    res.write('data: {"choices":[{"delta":{"content":"hi"}}]}\n\n');
+    return res.end('data: [DONE]\n\n');
+  }
+  res.writeHead(200, {'content-type':'application/json'});
+  res.end(JSON.stringify({ choices:[{message: mode === 'tools' ? {tool_calls:[{id:'call-1',function:{name:'echo',arguments:'{}'}}]} : {content:'ok'}}] }));
+});
+await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+const port = server.address().port;
+process.env.OMNIROUTE_OFFLINE_UPSTREAM_URL = `http://127.0.0.1:${port}/v1/chat/completions`;
+process.env.OMNIROUTE_OFFLINE_MODEL = 'mock-free-model';
+process.env.OMNIROUTE_OFFLINE_CONNECTION_ID = 'mock-connection';
+process.env.OMNIROUTE_OFFLINE_HOP_ID = 'omni-test';
+process.env.OMNIROUTE_REQUEST_DEADLINE_MS = '200';
+const request = (mode, overrides = {}) => new Request('http://127.0.0.1/v1/chat/completions', {
+  method:'POST', headers:{'content-type':'application/json','x-omniroute-connection':'mock-connection',...(overrides.headers||{})},
+  body:JSON.stringify({model:'mock-free-model',messages:[{role:'user',content:mode}],...(overrides.body||{})}),
+  signal:overrides.signal,
+});
+try {
+  await test('normal, tools, SSE each dispatch once', async () => {
+    for (const mode of ['normal','tools','stream']) {
+      const before=seen.length, result=await strictOfflineChat(request(mode));
+      assert.equal(result.status,200);
+      const text=await result.text();
+      assert.match(text,mode==='stream' ? /\[DONE\]/ : mode==='tools' ? /call-1/ : /ok/);
+      assert.equal(seen.length,before+1);
+      assert.equal(seen.at(-1).hop,'omni-test');
+    }
+  });
+  await test('503 is passed through with one dispatch', async () => {
+    const before=seen.length, result=await strictOfflineChat(request('error'));
+    assert.equal(result.status,503); assert.equal(seen.length,before+1);
+  });
+  await test('deadline yields 504 with one dispatch', async () => {
+    const before=seen.length, start=Date.now(), result=await strictOfflineChat(request('slow'));
+    assert.equal(result.status,504); assert.ok(Date.now()-start<450);
+    assert.equal(seen.length,before+1);
+  });
+  await test('rejects model, connection, loop before dispatch', async () => {
+    const before=seen.length;
+    assert.equal((await strictOfflineChat(request('x',{body:{model:'unknown'}}))).status,400);
+    assert.equal((await strictOfflineChat(request('x',{headers:{'x-omniroute-connection':'unknown'}}))).status,403);
+    assert.equal((await strictOfflineChat(request('x',{headers:{'x-omniroute-hop':'omni-test'}}))).status,508);
+    assert.equal(seen.length,before);
+  });
+  await test('rejects external destination before dispatch', async () => {
+    const before=seen.length, original=process.env.OMNIROUTE_OFFLINE_UPSTREAM_URL;
+    process.env.OMNIROUTE_OFFLINE_UPSTREAM_URL='https://example.invalid/v1/chat/completions';
+    try { assert.equal((await strictOfflineChat(request('x'))).status,503); }
+    finally { process.env.OMNIROUTE_OFFLINE_UPSTREAM_URL=original; }
+    assert.equal(seen.length,before);
+  });
+  await test('connection refusal fails without retry', async () => {
+    const original=process.env.OMNIROUTE_OFFLINE_UPSTREAM_URL;
+    process.env.OMNIROUTE_OFFLINE_UPSTREAM_URL='http://127.0.0.1:1/v1/chat/completions';
+    try { assert.equal((await strictOfflineChat(request('x'))).status,503); }
+    finally { process.env.OMNIROUTE_OFFLINE_UPSTREAM_URL=original; }
+  });
+} finally { server.close(); }
